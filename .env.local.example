# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Backlog <onboarding@resend.dev>

# Weekly digest cron authentication
CRON_SECRET=your_cron_secret

# Google AI (embeddings for semantic search)
GOOGLE_API_KEY=your_google_api_key

# Langflow / DataStax (AI digest summary)
LANGFLOW_TOKEN=your_langflow_token
LANGFLOW_ORG_ID=your_langflow_org_id
LANGFLOW_FLOW_URL=https://aws-us-east-2.langflow.datastax.com/lf/your-flow-id/api/v1/run/your-run-id
